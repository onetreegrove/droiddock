{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidDock",
  "version": "0.1.3",
  "identifier": "com.justonetree.droiddock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DroidDock",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "windowBackground"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "icons/background.png",
        "windowPosition": {
          "x": 400,
          "y": 400
        },
        "windowSize": {
          "width": 600,
          "height": 400
        },
        "appPosition": {
          "x": 150,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 150
        }
      }
    }
  }
}
